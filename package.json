{
  "name": "@theatre/server",
  "private": true,
  "version": "1.6.1",
  "license": "AGPL-3.0",
  "type": "module",
  "packageManager": "npm@12.2.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -b",
    "start": "node dist/server.js",
    "typecheck": "tsc -b --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "db:migrate": "tsx src/db/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint .",
    "ci": "commitlint --from main --to HEAD && npm run format:check && npm run lint && npm run typecheck && npm run test",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "postgres": "^3.4.9",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.7.5",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "husky": "^9.1.7",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "supertest": "^7.3.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "argon2@0.45.1": true
  }
}
