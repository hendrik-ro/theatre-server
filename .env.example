NODE_ENV=development

#Server
SERVER_PORT=3000

#Database
# POSTGRES_HOST and POSTGRES_PORT are the host-side dev values (the
# compose db publishes its port on the host). Inside the container
# network, docker-compose.yml overrides them to `db:5432`.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="theatre"

#Auth
# Generate each secret with: openssl rand -base64 32
JWT_SECRET="replace-with-the-output-of-openssl-rand-base64-32"
REFRESH_SECRET="replace-with-the-output-of-openssl-rand-base64-32"
