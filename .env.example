NODE_ENV=development

#Server
SERVER_PORT=3000

#Database
# Matches the compose database (host port 5432, see docker-compose.yml)
DB_URL="postgres://postgres:postgres@localhost:5432/theatre"

#Auth
# Generate each secret with: openssl rand -base64 32
JWT_SECRET="replace-with-the-output-of-openssl-rand-base64-32"
REFRESH_SECRET="replace-with-the-output-of-openssl-rand-base64-32"
